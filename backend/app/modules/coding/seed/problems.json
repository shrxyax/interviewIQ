      "id": "code.two_sum", "title": "Two Sum", "difficulty": "Easy",
      "statement": "Given an array of integers `nums` and an integer `target`, return the indices of the two numbers that add up to `target`, as a list `[i, j]` with i < j. Assume exactly one solution exists.",
      "signature": "def solve(nums, target):",
      "starter_code": "def solve(nums, target):\n    # return [i, j]\n    pass\n",
      "sample_tests": [{"args": [[2, 7, 11, 15], 9], "expected": [0, 1]}],
      "hidden_tests": [
        {"args": [[3, 2, 4], 6], "expected": [1, 2]},
        {"args": [[3, 3], 6], "expected": [0, 1]},
        {"args": [[-1, -2, -3, -4, -5], -8], "expected": [2, 4]}
      ]
    },
